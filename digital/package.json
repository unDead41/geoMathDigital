{
  "name": "geodecoder-digital",
  "version": "2.10.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check.mjs && node tools/check-assets.mjs",
    "standalone": "node tools/build.mjs",
    "build": "node tools/build.mjs",
    "test:browser": "node tests/usability.browser.mjs",
    "test:duel": "node tests/duel.browser.mjs",
    "test:practice": "node tests/practice.browser.mjs",
    "test:rich-text": "node tests/rich-text.browser.mjs",
    "preview:security": "node tools/security-preview.mjs",
    "prepare:pages": "node tools/prepare-publication.mjs",
    "release:check": "npm run verify",
    "test:help": "node tests/help-support.browser.mjs",
    "test:solo": "node tests/solo.browser.mjs",
    "design:tokens": "node tools/design-tokens.mjs",
    "design:check": "node tools/design-tokens.mjs --check",
    "design:reference": "node tools/design-reference.mjs",
    "test:design": "node tests/design-system.browser.mjs && node tests/design-reference.browser.mjs",
    "test:help-visuals": "node tests/help-visuals.browser.mjs",
    "pretest": "npm run build",
    "test:module": "npm --prefix module test",
    "verify": "npm test && npm run test:module && npm run prepare:pages && npm run check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3"
  }
}
